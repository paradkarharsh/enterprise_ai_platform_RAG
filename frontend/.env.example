# ==============================================================================
# Frontend Environment Variables for Manthan AI Next.js 15 app
# Copy this file to .env.local in the frontend directory.
# ==============================================================================

# URL of the backend API Gateway
# Option 1 (Recommended for Vercel): Private server-side variable (avoids exposing URL to browser & eliminates CORS)
API_URL=http://localhost:8000

# Option 2: Public client-side variable (if you prefer direct browser calls)
# NEXT_PUBLIC_API_URL=http://localhost:8000
